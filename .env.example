# Supabase Project Credentials
# When filled, the app automatically switches from the local zero-config
# demo data store to your live Supabase cloud database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public App Base URL
VITE_APP_URL=https://menuora.dz

